<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Kuis Interaktif</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #f6f8fd 0%, #f1f6fd 100%);
        }

        /* Animations */
        .fade-in-up {
            animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        
        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .slide-in-right {
            animation: slideInRight 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateX(30px);
        }

        @keyframes slideInRight {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .pulse-soft {
            animation: pulseSoft 2s infinite;
        }

        @keyframes pulseSoft {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4); }
            70% { transform: scale(1.02); box-shadow: 0 0 0 15px rgba(37, 99, 235, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
        }

        /* Option Button Styles */
        .option-button {
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }
        
        .option-button:hover:not(.selected) {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.1), 0 8px 10px -6px rgba(59, 130, 246, 0.1);
            border-color: #93c5fd;
        }

        .option-button.selected {
            background-color: #eff6ff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
            transform: scale(1.01);
        }

        .option-button.selected .option-letter {
            background-color: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }

        /* Review Styles */
        .review-correct {
            border-color: #22c55e !important;
            background-color: #f0fdf4 !important;
        }
        .review-incorrect {
            border-color: #ef4444 !important;
            background-color: #fef2f2 !important;
        }

        /* Glassmorphism elements */
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05);
        }

        /* Custom Scrollbars */
        .custom-scrollbar::-webkit-scrollbar { width: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .view-section {
            display: none;
        }
        .view-section.active {
            display: block;
        }
        .view-section.active-flex {
            display: flex;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 md:p-8 text-gray-800">

    <!-- Main Container -->
    <div id="app" class="w-full max-w-4xl glass-card rounded-3xl overflow-hidden relative min-h-[600px] flex flex-col">
        
        <!-- Animated Background Elements -->
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-400 via-indigo-500 to-purple-500 z-10"></div>
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-100 rounded-full mix-blend-multiply filter blur-2xl opacity-70"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-purple-100 rounded-full mix-blend-multiply filter blur-2xl opacity-70"></div>

        <!-- ==================== MAIN MENU ==================== -->
        <div id="main-menu" class="view-section active p-8 md:p-12 text-center flex-col items-center justify-center flex-grow z-10 relative">
            <div class="mb-10 fade-in-up">
                <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-700">
                    Portal Kuis Interaktif
                </h1>
                <p class="text-gray-500 text-lg">Silakan pilih peran Anda untuk melanjutkan</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-2xl mx-auto fade-in-up" style="animation-delay: 0.2s;">
                <!-- Card Peserta -->
                <button onclick="navigate('peserta-dashboard')" class="group p-8 bg-white border-2 border-gray-100 rounded-2xl hover:border-blue-400 hover:shadow-xl transition-all text-left flex flex-col items-center text-center">
                    <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v6.5"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Masuk Sebagai Peserta</h3>
                    <p class="text-gray-500 text-sm">Ikuti ujian, uji kemampuanmu, dan lihat hasilnya secara instan.</p>
                </button>

                <!-- Card Admin -->
                <button onclick="navigate('admin-dashboard')" class="group p-8 bg-white border-2 border-gray-100 rounded-2xl hover:border-purple-400 hover:shadow-xl transition-all text-left flex flex-col items-center text-center">
                    <div class="w-20 h-20 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Masuk Sebagai Admin</h3>
                    <p class="text-gray-500 text-sm">Kelola bank soal, tambah, ubah, atau hapus pertanyaan kuis.</p>
                </button>
            </div>
        </div>

        <!-- ==================== DASHBOARD PESERTA ==================== -->
        <div id="peserta-dashboard" class="view-section p-8 md:p-12 flex-col items-center justify-center min-h-[500px] z-10 relative">
            <button onclick="navigate('main-menu')" class="absolute top-8 left-8 text-gray-500 hover:text-gray-800 flex items-center gap-2 font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Kembali
            </button>

            <div class="text-center mt-8 w-full max-w-2xl mx-auto">
                <div class="inline-block p-4 rounded-3xl bg-blue-50 text-blue-600 mb-6 fade-in-up">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                </div>
                <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-gray-800 fade-in-up" style="animation-delay: 0.1s;">Ujian Kompetensi Sosial Media</h2>
                
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mb-10 fade-in-up" style="animation-delay: 0.2s;">
                    <div class="flex justify-around items-center divide-x divide-gray-100">
                        <div class="px-4 text-center">
                            <span class="block text-3xl font-bold text-blue-600 mb-1" id="info-total-soal">0</span>
                            <span class="text-sm text-gray-500 font-medium">Total Soal</span>
                        </div>
                        <div class="px-4 text-center">
                            <span class="block text-3xl font-bold text-indigo-600 mb-1">PG</span>
                            <span class="text-sm text-gray-500 font-medium">Jenis Soal</span>
                        </div>
                    </div>
                </div>

                <div class="fade-in-up" style="animation-delay: 0.3s;">
                    <button onclick="startQuiz()" class="group w-full md:w-auto relative inline-flex items-center justify-center px-10 py-5 font-bold text-white text-xl bg-blue-600 rounded-2xl hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-300 pulse-soft shadow-xl transition-all">
                        🚀 MULAI KUIS SEKARANG
                        <svg class="w-6 h-6 ml-3 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </button>
                    <p id="error-no-questions" class="text-red-500 mt-4 hidden font-medium">Maaf, admin belum menambahkan soal kuis.</p>
                </div>
            </div>
        </div>

        <!-- ==================== DASHBOARD ADMIN ==================== -->
        <div id="admin-dashboard" class="view-section flex-col h-full z-10 relative">
            <div class="px-8 pt-8 pb-4 border-b border-gray-100 flex justify-between items-center bg-white/50">
                <button onclick="navigate('main-menu')" class="text-gray-500 hover:text-gray-800 flex items-center gap-2 font-medium">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali
                </button>
                <h2 class="text-xl font-bold text-gray-800">Bank Soal (Admin)</h2>
                <button onclick="openModal()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Tambah Soal
                </button>
            </div>

            <div class="flex-grow p-8 bg-gray-50/30">
                <div id="admin-questions-list" class="space-y-4 max-h-[500px] overflow-y-auto custom-scrollbar pr-2 pb-8">
                    <!-- Pertanyaan diload oleh JS -->
                </div>
            </div>
        </div>

        <!-- ==================== QUIZ SCREEN ==================== -->
        <div id="quiz-screen" class="view-section flex-col h-full z-10 relative">
            <!-- Progress Header -->
            <div class="px-8 pt-8 pb-4 border-b border-gray-100 flex justify-between items-center bg-white/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm" id="question-number-badge">1</div>
                    <span class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Pertanyaan</span>
                </div>
                <div class="text-sm font-medium text-gray-400">
                    <span id="current-q-index" class="text-gray-800 font-bold">1</span> / <span id="total-q">15</span>
                </div>
            </div>
            
            <!-- Progress Bar -->
            <div class="h-1 bg-gray-100 w-full relative">
                <div id="progress-bar" class="absolute top-0 left-0 h-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-500 ease-out" style="width: 0%;"></div>
            </div>

            <div class="p-8 md:p-10 flex-grow">
                <!-- Question Text -->
                <div id="question-container" class="min-h-[120px] mb-8">
                    <h2 id="question-text" class="text-xl md:text-2xl font-bold text-gray-800 leading-tight"></h2>
                </div>
                
                <!-- Options -->
                <div id="options-container" class="space-y-4">
                    <!-- Options injected by JS -->
                </div>
            </div>

            <!-- Footer Navigation -->
            <div class="px-8 py-6 bg-gray-50/50 border-t border-gray-100 flex justify-between items-center mt-auto rounded-b-3xl">
                <button id="prev-button" onclick="prevQuestion()" class="px-6 py-2.5 text-gray-500 font-medium hover:text-gray-800 transition-colors flex items-center gap-2 opacity-50 cursor-not-allowed" disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali
                </button>
                <button id="next-button" onclick="nextQuestion()" class="px-8 py-3 bg-gray-900 hover:bg-black text-white font-semibold rounded-xl shadow-md transition-all flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    Selanjutnya
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </div>
        </div>

        <!-- ==================== RESULT SCREEN ==================== -->
        <div id="result-screen" class="view-section p-8 md:p-10 z-10 relative custom-scrollbar overflow-y-auto max-h-full">
            <div class="text-center mb-10 fade-in-up">
                <div class="inline-block px-4 py-1.5 rounded-full bg-blue-50 text-blue-600 font-semibold text-sm mb-4">Ujian Selesai</div>
                <h2 class="text-3xl font-extrabold mb-2 text-gray-800">Hasil Evaluasi</h2>
                
                <div class="flex justify-center items-center gap-8 mt-8 mb-6 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <div class="text-center">
                        <div class="text-5xl font-black text-blue-600 mb-1" id="final-score">0</div>
                        <div class="text-sm text-gray-500 font-medium">Skor Total (%)</div>
                    </div>
                    <div class="w-px h-16 bg-gray-200"></div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-green-500 mb-1" id="correct-count">0</div>
                        <div class="text-sm text-gray-500 font-medium">Benar</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-red-500 mb-1" id="incorrect-count">0</div>
                        <div class="text-sm text-gray-500 font-medium">Salah</div>
                    </div>
                </div>
                
                <p id="score-message" class="text-lg font-medium text-gray-600"></p>
            </div>

            <!-- Review Section -->
            <div class="mt-8 border-t border-gray-100 pt-8 fade-in-up" style="animation-delay: 0.2s;">
                <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                    Review Jawaban
                </h3>
                <div id="review-container" class="space-y-4">
                    <!-- Review items injected here -->
                </div>
            </div>

            <div class="mt-8 flex justify-center gap-4 fade-in-up pb-8" style="animation-delay: 0.4s;">
                <button onclick="navigate('peserta-dashboard')" class="px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded-xl transition-colors flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Dashboard
                </button>
                <button onclick="startQuiz()" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors flex items-center gap-2 shadow-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Ulangi Kuis
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Form (Admin) -->
    <div id="admin-modal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 id="modal-title" class="text-xl font-bold text-gray-800">Tambah Soal Baru</h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="p-6 overflow-y-auto custom-scrollbar flex-grow">
                <form id="question-form" class="space-y-5">
                    <input type="hidden" id="edit-index" value="-1">
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Pertanyaan</label>
                        <textarea id="form-question" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" placeholder="Tuliskan pertanyaan kuis di sini..." required></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Opsi A</label>
                            <input type="text" id="form-opt-a" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Opsi B</label>
                            <input type="text" id="form-opt-b" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Opsi C</label>
                            <input type="text" id="form-opt-c" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Opsi D</label>
                            <input type="text" id="form-opt-d" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" required>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Jawaban Benar</label>
                        <select id="form-answer" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" required>
                            <option value="A">Opsi A</option>
                            <option value="B">Opsi B</option>
                            <option value="C">Opsi C</option>
                            <option value="D">Opsi D</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-3">
                <button onclick="closeModal()" class="px-5 py-2 text-gray-600 bg-white border border-gray-300 hover:bg-gray-50 font-medium rounded-xl transition-colors">Batal</button>
                <button onclick="saveQuestion()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-sm transition-colors">Simpan Soal</button>
            </div>
        </div>
    </div>

    <script>
        // Default Data
        const defaultQuestions = [
            { question: "Apa yang dimaksud dengan Social Media Specialist?", options: [{ id: "A", text: "Orang yang hanya membuat desain logo" }, { id: "B", text: "Orang yang bertugas mengelola dan mengembangkan aktivitas media sosial" }, { id: "C", text: "Orang yang hanya membuat website" }, { id: "D", text: "Orang yang bertugas mengedit video film" }], answer: "B" },
            { question: "Salah satu tugas utama Social Media Specialist adalah...", options: [{ id: "A", text: "Mengelola strategi dan konten media sosial" }, { id: "B", text: "Memperbaiki komputer rusak" }, { id: "C", text: "Membuat laporan keuangan perusahaan" }, { id: "D", text: "Mengelola jaringan internet" }], answer: "A" },
            { question: "Apa fungsi utama dari content planning?", options: [{ id: "A", text: "Menghapus semua konten lama" }, { id: "B", text: "Mengatur jadwal, tema, dan jenis konten yang akan dipublikasikan" }, { id: "C", text: "Membuat password akun media sosial" }, { id: "D", text: "Mengganti nama akun setiap minggu" }], answer: "B" },
            { question: "Sebelum membuat konten, sebaiknya mengetahui...", options: [{ id: "A", text: "Warna favorit karyawan" }, { id: "B", text: "Jenis komputer perusahaan" }, { id: "C", text: "Target audiens yang ingin dijangkau" }, { id: "D", text: "Jumlah aplikasi di HP" }], answer: "C" },
            { question: "Apa yang dimaksud dengan target audience?", options: [{ id: "A", text: "Orang yang membuat konten" }, { id: "B", text: "Kelompok orang yang menjadi sasaran sebuah konten" }, { id: "C", text: "Admin pengelola medsos" }, { id: "D", text: "Pemilik perangkat" }], answer: "B" }
        ];

        // System State
        let allQuestions = [];
        let activeQuizQuestions = [];
        let userAnswers = [];
        let currentQuestionIndex = 0;

        // Initialization
        function initApp() {
            // Load dari local storage atau gunakan default
            const savedData = localStorage.getItem('quiz_app_data');
            if(savedData) {
                allQuestions = JSON.parse(savedData);
            } else {
                allQuestions = [...defaultQuestions];
                saveToLocalStorage();
            }
            updatePesertaInfo();
        }

        function saveToLocalStorage() {
            localStorage.setItem('quiz_app_data', JSON.stringify(allQuestions));
            updatePesertaInfo();
        }

        function updatePesertaInfo() {
            document.getElementById('info-total-soal').textContent = allQuestions.length;
        }

        // Navigation Management
        function navigate(viewId) {
            document.querySelectorAll('.view-section').forEach(el => {
                el.classList.remove('active', 'active-flex');
            });
            
            const target = document.getElementById(viewId);
            if(viewId === 'quiz-screen' || viewId === 'admin-dashboard' || viewId === 'peserta-dashboard' || viewId === 'main-menu') {
                target.classList.add('active-flex');
            } else {
                target.classList.add('active');
            }

            if(viewId === 'admin-dashboard') {
                renderAdminList();
            }
        }

        // ==================== ADMIN SYSTEM ====================

        function renderAdminList() {
            const listContainer = document.getElementById('admin-questions-list');
            listContainer.innerHTML = '';

            if(allQuestions.length === 0) {
                listContainer.innerHTML = '<div class="text-center text-gray-500 py-10">Belum ada soal. Silakan tambah soal baru.</div>';
                return;
            }

            allQuestions.forEach((q, index) => {
                const item = document.createElement('div');
                item.className = 'bg-white p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col md:flex-row gap-4 justify-between items-start md:items-center hover:border-indigo-300 transition-colors';
                
                let optionsHtml = q.options.map(o => 
                    `<span class="${o.id === q.answer ? 'text-green-600 font-bold' : 'text-gray-500'}">${o.id}: ${o.text}</span>`
                ).join(' | ');

                item.innerHTML = `
                    <div class="flex-grow">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="bg-indigo-100 text-indigo-700 text-xs font-bold px-2 py-1 rounded">Soal ${index + 1}</span>
                        </div>
                        <p class="font-bold text-gray-800 mb-2">${q.question}</p>
                        <div class="text-sm space-x-2 truncate max-w-xl">${optionsHtml}</div>
                    </div>
                    <div class="flex gap-2 w-full md:w-auto mt-4 md:mt-0">
                        <button onclick="editQuestion(${index})" class="flex-1 md:flex-none px-4 py-2 bg-blue-50 text-blue-600 hover:bg-blue-100 font-medium rounded-lg transition-colors">Edit</button>
                        <button onclick="deleteQuestion(${index})" class="flex-1 md:flex-none px-4 py-2 bg-red-50 text-red-600 hover:bg-red-100 font-medium rounded-lg transition-colors">Hapus</button>
                    </div>
                `;
                listContainer.appendChild(item);
            });
        }

        function openModal(editIndex = -1) {
            document.getElementById('admin-modal').classList.remove('hidden');
            const form = document.getElementById('question-form');
            form.reset();
            
            document.getElementById('edit-index').value = editIndex;
            
            if (editIndex > -1) {
                document.getElementById('modal-title').textContent = 'Edit Soal';
                const q = allQuestions[editIndex];
                document.getElementById('form-question').value = q.question;
                document.getElementById('form-opt-a').value = q.options.find(o => o.id === 'A').text;
                document.getElementById('form-opt-b').value = q.options.find(o => o.id === 'B').text;
                document.getElementById('form-opt-c').value = q.options.find(o => o.id === 'C').text;
                document.getElementById('form-opt-d').value = q.options.find(o => o.id === 'D').text;
                document.getElementById('form-answer').value = q.answer;
            } else {
                document.getElementById('modal-title').textContent = 'Tambah Soal Baru';
            }
        }

        function closeModal() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function saveQuestion() {
            // Validasi manual sederhana
            const question = document.getElementById('form-question').value.trim();
            const optA = document.getElementById('form-opt-a').value.trim();
            const optB = document.getElementById('form-opt-b').value.trim();
            const optC = document.getElementById('form-opt-c').value.trim();
            const optD = document.getElementById('form-opt-d').value.trim();
            const answer = document.getElementById('form-answer').value;

            if(!question || !optA || !optB || !optC || !optD) {
                alert("Mohon lengkapi semua bidang (Pertanyaan dan semua Opsi)!");
                return;
            }

            const newQuestionData = {
                question: question,
                options: [
                    { id: "A", text: optA },
                    { id: "B", text: optB },
                    { id: "C", text: optC },
                    { id: "D", text: optD }
                ],
                answer: answer
            };

            const editIndex = parseInt(document.getElementById('edit-index').value);
            
            if (editIndex > -1) {
                allQuestions[editIndex] = newQuestionData;
            } else {
                allQuestions.push(newQuestionData);
            }

            saveToLocalStorage();
            closeModal();
            renderAdminList();
        }

        function editQuestion(index) {
            openModal(index);
        }

        function deleteQuestion(index) {
            if(confirm('Apakah Anda yakin ingin menghapus soal ini?')) {
                allQuestions.splice(index, 1);
                saveToLocalStorage();
                renderAdminList();
            }
        }


        // ==================== QUIZ SYSTEM ====================

        function shuffleArray(array) {
            const newArray = [...array];
            for (let i = newArray.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
            }
            return newArray;
        }

        function startQuiz() {
            if(allQuestions.length === 0) {
                document.getElementById('error-no-questions').classList.remove('hidden');
                return;
            }
            document.getElementById('error-no-questions').classList.add('hidden');

            activeQuizQuestions = shuffleArray(allQuestions);
            userAnswers = new Array(activeQuizQuestions.length).fill(null);
            currentQuestionIndex = 0;
            
            document.getElementById('total-q').textContent = activeQuizQuestions.length;
            
            navigate('quiz-screen');
            loadQuestion();
        }

        function loadQuestion() {
            const q = activeQuizQuestions[currentQuestionIndex];
            
            // UI Updates
            document.getElementById('current-q-index').textContent = currentQuestionIndex + 1;
            document.getElementById('question-number-badge').textContent = currentQuestionIndex + 1;
            document.getElementById('progress-bar').style.width = `${((currentQuestionIndex) / activeQuizQuestions.length) * 100}%`;
            
            // Buttons State
            const prevBtn = document.getElementById('prev-button');
            const nextBtn = document.getElementById('next-button');
            
            prevBtn.disabled = currentQuestionIndex === 0;
            if(prevBtn.disabled) {
                prevBtn.classList.add('opacity-50', 'cursor-not-allowed');
                prevBtn.classList.remove('hover:text-gray-800');
            } else {
                prevBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                prevBtn.classList.add('hover:text-gray-800');
            }

            if(currentQuestionIndex === activeQuizQuestions.length - 1) {
                nextBtn.innerHTML = `Selesaikan Ujian <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
                nextBtn.classList.remove('bg-gray-900', 'hover:bg-black');
                nextBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
            } else {
                nextBtn.innerHTML = `Selanjutnya <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>`;
                nextBtn.classList.add('bg-gray-900', 'hover:bg-black');
                nextBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
            }

            updateNextButtonState();

            // Text Setup
            const qText = document.getElementById('question-text');
            qText.parentElement.classList.remove('slide-in-right');
            void qText.parentElement.offsetWidth;
            qText.parentElement.classList.add('slide-in-right');
            qText.textContent = q.question;
            
            // Render Options
            const optContainer = document.getElementById('options-container');
            optContainer.innerHTML = '';
            
            q.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                const isSelected = userAnswers[currentQuestionIndex] === opt.id;
                
                btn.className = `w-full text-left p-4 md:p-5 rounded-2xl border-2 transition-all flex items-start gap-4 option-button slide-in-right bg-white
                                ${isSelected ? 'selected' : 'border-gray-200 text-gray-700'}`;
                btn.style.animationDelay = `${index * 0.1}s`;
                
                btn.innerHTML = `
                    <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold transition-colors option-letter
                                 ${isSelected ? 'bg-blue-600 text-white border-transparent' : 'bg-gray-100 text-gray-500 border border-gray-200'}">
                        ${opt.id}
                    </span>
                    <span class="mt-1 leading-relaxed">${opt.text}</span>
                `;
                
                btn.onclick = () => selectOption(opt.id);
                optContainer.appendChild(btn);
            });
        }

        function selectOption(selectedId) {
            userAnswers[currentQuestionIndex] = selectedId;
            
            const buttons = document.getElementById('options-container').children;
            Array.from(buttons).forEach((btn, index) => {
                const optId = activeQuizQuestions[currentQuestionIndex].options[index].id;
                const letterSpan = btn.querySelector('.option-letter');
                
                if(optId === selectedId) {
                    btn.classList.add('selected');
                    btn.classList.remove('border-gray-200', 'text-gray-700');
                    letterSpan.classList.add('bg-blue-600', 'text-white', 'border-transparent');
                    letterSpan.classList.remove('bg-gray-100', 'text-gray-500', 'border-gray-200');
                } else {
                    btn.classList.remove('selected');
                    btn.classList.add('border-gray-200', 'text-gray-700');
                    letterSpan.classList.remove('bg-blue-600', 'text-white', 'border-transparent');
                    letterSpan.classList.add('bg-gray-100', 'text-gray-500', 'border-gray-200');
                }
            });

            updateNextButtonState();
        }

        function updateNextButtonState() {
            document.getElementById('next-button').disabled = (userAnswers[currentQuestionIndex] === null);
        }

        function nextQuestion() {
            if (currentQuestionIndex < activeQuizQuestions.length - 1) {
                currentQuestionIndex++;
                loadQuestion();
            } else {
                finishQuiz();
            }
        }

        function prevQuestion() {
            if (currentQuestionIndex > 0) {
                currentQuestionIndex--;
                loadQuestion();
            }
        }

        function finishQuiz() {
            navigate('result-screen');
            calculateAndShowResults();
        }

        function calculateAndShowResults() {
            let correctCount = 0;
            const reviewContainer = document.getElementById('review-container');
            reviewContainer.innerHTML = '';

            activeQuizQuestions.forEach((q, index) => {
                const userAnswerId = userAnswers[index];
                const isCorrect = userAnswerId === q.answer;
                
                if(isCorrect) correctCount++;

                const reviewItem = document.createElement('div');
                reviewItem.className = `p-5 rounded-2xl border-2 mb-4 ${isCorrect ? 'review-correct' : 'review-incorrect'} bg-white`;
                
                const userAnswerText = q.options.find(o => o.id === userAnswerId)?.text || "Tidak dijawab";
                const correctAnswerText = q.options.find(o => o.id === q.answer).text;

                let iconSvg = isCorrect 
                    ? `<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
                    : `<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

                reviewItem.innerHTML = `
                    <div class="flex items-start gap-3 mb-3">
                        <div class="mt-1 flex-shrink-0">${iconSvg}</div>
                        <div>
                            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 block">Soal ${index + 1}</span>
                            <p class="font-semibold text-gray-800">${q.question}</p>
                        </div>
                    </div>
                    <div class="pl-9 space-y-2">
                        <div class="text-sm p-3 rounded-lg ${isCorrect ? 'bg-green-100/50 text-green-800 border-green-200' : 'bg-red-50 text-red-800 border-red-200'} border">
                            <span class="font-semibold block mb-1">Jawaban Kamu:</span>
                            ${userAnswerText}
                        </div>
                        ${!isCorrect ? `
                        <div class="text-sm p-3 rounded-lg bg-green-50 text-green-800 border border-green-200 mt-2">
                            <span class="font-semibold block mb-1">Jawaban Benar:</span>
                            ${correctAnswerText}
                        </div>
                        ` : ''}
                    </div>
                `;
                reviewContainer.appendChild(reviewItem);
            });

            const total = activeQuizQuestions.length;
            const incorrectCount = total - correctCount;
            const scorePercentage = Math.round((correctCount / total) * 100);

            animateValue("final-score", 0, scorePercentage, 1000);
            document.getElementById('correct-count').textContent = correctCount;
            document.getElementById('incorrect-count').textContent = incorrectCount;

            const scoreMsgEl = document.getElementById('score-message');
            if(scorePercentage >= 90) {
                scoreMsgEl.innerHTML = "Luar biasa! 🌟 Pemahamanmu sangat kuat.";
            } else if(scorePercentage >= 70) {
                scoreMsgEl.innerHTML = "Kerja bagus! 👍 Kamu sudah cukup menguasai materinya.";
            } else if(scorePercentage >= 50) {
                scoreMsgEl.innerHTML = "Lumayan. 🤔 Masih perlu sedikit me-<i>review</i> kembali konsep dasarnya.";
            } else {
                scoreMsgEl.innerHTML = "Jangan menyerah! 💪 Baca lagi materinya dan coba lagi.";
            }
        }

        function animateValue(id, start, end, duration) {
            const obj = document.getElementById(id);
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                const easeProgress = 1 - Math.pow(1 - progress, 3);
                obj.innerHTML = Math.floor(easeProgress * (end - start) + start);
                if (progress < 1) window.requestAnimationFrame(step);
            };
            window.requestAnimationFrame(step);
        }

        // Initialize the app on load
        window.onload = initApp;

    </script>
</body>
</html>
